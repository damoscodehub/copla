{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copla",
  "version": "0.1.0",
  "identifier": "com.damo.copla",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Copla", "width": 1440, "height": 940, "minWidth": 960, "minHeight": 640, "backgroundColor": "#111214" }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "fileAssociations": [{ "ext": ["copla", "coplapack"], "name": "Copla Session", "role": "Editor" }] }
}
